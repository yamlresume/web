{
  "name": "yamlresume-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "check": "biome check --write --unsafe src",
    "check:ci": "biome check --unsafe src",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:ui": "vitest --config vitest.e2e.config.ts --ui",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@tabler/icons-react": "^3.45.0",
    "@vercel/analytics": "^2.0.1",
    "@yamlresume/playground": "^0.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.11.5",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^19.2.8",
    "react-medium-image-zoom": "^5.4.8",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "execa": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.1",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*": "pnpm check"
  }
}
